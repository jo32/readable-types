{
  "name": "typescript-type-functions",
  "version": "0.2.0",
  "private": true,
  "description": "Composable TypeScript type functions, from small primitives to practical transformations.",
  "type": "module",
  "engines": { "node": ">=22" },
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./runtime": { "types": "./dist/runtime.d.ts", "import": "./dist/runtime.js" }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test:types": "tsc -p tsconfig.json",
    "test:runtime": "npm run build && node --test tests/runtime.test.mjs",
    "test:challenges": "tsc -p tests/challenges/tsconfig.json",
    "test": "npm run test:types && npm run test:runtime"
  },
  "devDependencies": { "typescript": "7.0.2" }
}
